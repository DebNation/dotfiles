# STATUS BAR
bar {
    position top
    status_command ~/.config/sway/statuscommand 

    # status_command i3status # or i3blocks
    font pango:IosevkaTermSlab Nerd Font SemiBold 8
    position top

    #swaybar_command waybar
    
    icon_theme $icon_theme

    colors {
        statusline $fg
        background $bg
        #                   border  bg      text
        focused_workspace   $accent $accent $bg
        inactive_workspace  $bg     $bg     $fg
        urgent_workspace    $bg     $bg     $fg
    }
}

# WINDOW COLORS
# class                 border  backgr. text    indicator child_border
client.focused          $accent $bg     $fg     $accent   $accent
client.focused_inactive $bg     $bg     $fg     $bg       $bg
client.unfocused        $bg     $bg     $fg     $bg       $bg
client.urgent           $bg     $bg     $fg     $bg       $bg
client.placeholder      $bg     $bg     $fg     $bg       $bg

client.background       $bg

# AUTOSTART
exec_always {
    pidof /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 || /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    #pidof nm-applet || nm-applet
    #pidof steam || steam -silent
    #pidof Enpass || QT_SCALE_FACTOR=2 /opt/enpass/Enpass -minimize
    pidof dunst || dunst
    wl-paste --type text --watch cliphist store
}

