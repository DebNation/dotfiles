return {
	"nvim-mini/mini.nvim",
	version = false,
	config = function()
		local notify = require("mini.notify")

		notify.setup({
			content = {
				format = function(notif)
					return notify.default_format(notif, { duration = 5000 })
				end,
			},

			lsp_progress = {
				enable = true,
				level = "INFO",
				duration_last = 5000,
			},

			window = {
				config = function()
					local has_statusline = vim.o.laststatus > 0
					local bottom_offset = has_statusline and 2 or 1

					return {
						border = "none",
						anchor = "SE",
						col = vim.o.columns,
						row = vim.o.lines - bottom_offset - (vim.o.cmdheight or 1),
					}
				end,
				max_width_share = 0.382,
				winblend = 100,
			},
		})

		vim.api.nvim_set_hl(0, "MiniNotifyNormal", { bg = "NONE" })
		vim.notify = notify.make_notify()
	end,
}
