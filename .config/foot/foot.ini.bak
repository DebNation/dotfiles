# -*- conf -*-

term = xterm-256color
[main]
#font = Symbols Nerd Font Mono:size=14, JetBrainsMono Nerd Font Mono:size=14

font=JetBrains Mono:style=Regular:size=12, Symbols Nerd Font Mono:size=12, Noto Color Emoji:size=12

#dpi-aware = yes
pad = 8x8
# pad=5x5
# resize-delay-ms=100

[url]
launch=xdg-open ${url}
# Underlines standard URLs automatically
# osc8-underline=always

[cursor]
style=block
blink=no

[csd]
preferred = none

[mouse]
hide-when-typing=yes


[key-bindings]
# First, disable the default unicode-input to stop the conflict
unicode-input=none
# Now assign the URL launcher to that shortcut
show-urls-launch=Control+Shift+u
[mouse-bindings]
# Allows using Shift to bypass apps (like Vim) for selection/URLs
selection-override-modifiers=Shift

primary-paste=BTN_MIDDLE
select-begin=BTN_LEFT
select-begin-block=Control+BTN_LEFT
select-extend=BTN_RIGHT
select-extend-character-wise=Control+BTN_RIGHT
select-word=BTN_LEFT-2
select-word-whitespace=Control+BTN_LEFT-2
# We omit BTN_LEFT-3 (triple click) to avoid the select-quote conflict



[colors-dark]
# Gruvbox Dark Hard background & foreground
background=1d2021
foreground=ebdbb2

# Cursor color (Moved from [cursor])
cursor=1d2021 ebdbb2

# Selection colors
selection-background=d5c4a1
selection-foreground=1d2021

# Normal / regular ANSI colors
regular0=1d2021
regular1=cc241d
regular2=98971a
regular3=d79921
regular4=458588
regular5=b16286
regular6=689d6a
regular7=a89984

# Bright ANSI colors
bright0=928374
bright1=fb4934
bright2=b8bb26
bright3=fabd2f
bright4=83a598
bright5=d3869b
bright6=8ec07c
bright7=ebdbb2
